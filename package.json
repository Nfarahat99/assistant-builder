{
  "name": "assistant-builder",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin: build your personal assistant from assistant-template",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:contract": "node -e \"if(!process.env.TEMPLATE_DIR){console.error('set TEMPLATE_DIR');process.exit(1)}\" && cd \"$TEMPLATE_DIR\" && node --import tsx --test \"$INIT_CWD/tests/contract/template-contract.mjs\""
  }
}
